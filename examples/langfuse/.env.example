# Cat-Agent → Langfuse OTLP (used by @with_langfuse / configure_langfuse_otel)
#
# Copy:
#   cp examples/langfuse/.env.example examples/langfuse/.env
#
# Keys must match a Langfuse project. For local docker-compose demo they are
# seeded via LANGFUSE_INIT_PROJECT_* in docker-compose.yaml.

# Langfuse base URL (local compose exposes port 3000)
LANGFUSE_HOST=http://localhost:3000

# Project API keys (Langfuse UI → Project → Settings → API Keys)
# Same values as LANGFUSE_INIT_PROJECT_PUBLIC_KEY / SECRET_KEY in docker-compose.yaml
LANGFUSE_PUBLIC_KEY=pk-lf-cat-agent-demo
LANGFUSE_SECRET_KEY=sk-lf-cat-agent-demo

# Service name shown in Langfuse / OTel traces
OTEL_SERVICE_NAME=cat-agent

# Optional — usually leave commented; derived from LANGFUSE_HOST if unset
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
