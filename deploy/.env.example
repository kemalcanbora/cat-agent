# Copy to .env and fill in before `docker compose up`
# (Docker Compose also reads this file; Cat-Agent loads it automatically in Python.)
CAT_AGENT_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://llm-proxy:8080/v1
CAT_AGENT_OFFLINE_ALLOW_HOSTS=llm-proxy,llm.internal,10.0.0.0/8,192.168.0.0/16
