# Copy to .env and adjust for your deployment:
#   cp .env.example .env
#
# Cat-Agent loads this file automatically on import and via the cat-agent CLI.
# Use CAT_AGENT_ENV_FILE=/path/to/custom.env to point elsewhere.
# Values already set in the shell are not overwritten.

# --- On-prem / air-gap ---
CAT_AGENT_OFFLINE=1
CAT_AGENT_OFFLINE_ALLOW_HOSTS=llm.internal,llm-proxy,10.0.0.0/8,192.168.0.0/16

# --- LLM gateway (on-prem OpenAI-compatible API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://llm.internal:8080/v1

# --- Ollama Cloud (OpenAI-compatible; used by multi_agent / synthesis examples) ---
# CAT_AGENT_OFFLINE=0
# OLLAMA_API_KEY=
# LLM_MODEL=minimax-m2.5:cloud
# OLLAMA_API_BASE=https://ollama.com/v1
# Optional stronger model for draft interview / confirmation:
# INTAKE_LLM_MODEL=

 
# --- Encrypted storage ---
CAT_AGENT_ENCRYPT_AT_REST=1
CAT_AGENT_ENCRYPTION_KEY=
# CAT_AGENT_REQUIRE_ENCRYPTED_STORAGE=1

# --- Audit trail ---
# CAT_AGENT_AUDIT=1
# CAT_AGENT_AUDIT_PATH=./workspace/storage/audit/audit.jsonl

# --- PII redaction (enabled by default) ---
# CAT_AGENT_PII_REDACT=0

# --- Workspace ---
# CAT_AGENT_DEFAULT_WORKSPACE=workspace

# Group membership for synth promote/run (JSON: {"alice": ["finance","ops"]}).
# Keep this file read-only to end users. Default path: <workspace>/groups.json
# CAT_AGENT_USER=  # optional override of OS username for CLI identity

# --- Tool synthesis mutation gate ---
# After holdout passes, kill ratio must meet threshold or synthesis returns weak_spec.
# CAT_AGENT_MUTATION_ENABLED=1
# CAT_AGENT_MUTATION_LIMIT=12
# CAT_AGENT_MUTATION_THRESHOLD=0.8

# --- Scheduled reports (pip install 'cat-agent[scheduler]') ---
# Empty → sqlite:///workspace/scheduling/scheduling.sqlite
# CAT_AGENT_SCHEDULER_DSN=sqlite:///workspace/scheduling/scheduling.sqlite
# CAT_AGENT_SCHEDULER_MAX_JOBS_PER_USER=20
# CAT_AGENT_JOB_LIMIT=50
# CAT_AGENT_LEASE_SECONDS=900
# CAT_AGENT_SCHEDULER_MAX_REPORT_ITEMS=50

# On-demand FastAPI agent serve (requires cat-agent[serve])
# CAT_AGENT_SERVE_HOST=127.0.0.1
# CAT_AGENT_SERVE_PORT=8080
# CAT_AGENT_SERVE_TOKEN=
# CAT_AGENT_SERVE_MAX_CONCURRENCY=1
# CAT_AGENT_SERVE_MAX_QUEUE=8
# CAT_AGENT_SERVE_RETRY_AFTER_SECONDS=1
# Must be < orchestrator kill timeout or aclose() never runs (see settings.py)
# CAT_AGENT_SERVE_SHUTDOWN_TIMEOUT=45
# CAT_AGENT_SERVE_VERBOSE_ERRORS=0
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=reports@example.com
# SMTP_STARTTLS=1
# RESEND_API_KEY=   # optional; needs cat-agent[email]
# RESEND_FROM=

# --- Self-hosted web search (opt-in tool) ---
# CAT_AGENT_SEARXNG_URL=http://searxng.internal:8080

# --- Observability / run metrics ---
# Warn when server-reported prompt_tokens fall below this fraction of the local estimate
# (silent Ollama num_ctx truncation). Default 0.95 = 5% tokenizer tolerance.
# CAT_AGENT_PROMPT_TRUNCATION_TOLERANCE=0.95

# --- Langfuse / OpenTelemetry (examples/langfuse) ---
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-cat-agent-demo
# LANGFUSE_SECRET_KEY=sk-lf-cat-agent-demo
# OTEL_SERVICE_NAME=cat-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
