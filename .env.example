# Copy to .env and adjust for your deployment:
#   cp .env.example .env
#
# Cat-Agent loads this file automatically on import and via the cat-agent CLI.
# Use CAT_AGENT_ENV_FILE=/path/to/custom.env to point elsewhere.
# Values already set in the shell are not overwritten.

# --- On-prem / air-gap ---
CAT_AGENT_OFFLINE=1
CAT_AGENT_OFFLINE_ALLOW_HOSTS=llm.internal,llm-proxy,10.0.0.0/8,192.168.0.0/16

# --- LLM gateway (on-prem OpenAI-compatible API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://llm.internal:8080/v1

# --- Ollama Cloud (OpenAI-compatible; used by multi_agent / synthesis examples) ---
# CAT_AGENT_OFFLINE=0
# OLLAMA_API_KEY=
# LLM_MODEL=minimax-m2.5:cloud
# OLLAMA_BASE_URL=https://ollama.com/v1
# Optional stronger model for draft interview / confirmation:
# INTAKE_LLM_MODEL=

 
# --- Encrypted storage ---
CAT_AGENT_ENCRYPT_AT_REST=1
CAT_AGENT_ENCRYPTION_KEY=
# CAT_AGENT_REQUIRE_ENCRYPTED_STORAGE=1

# --- Audit trail ---
# CAT_AGENT_AUDIT=1
# CAT_AGENT_AUDIT_PATH=./workspace/storage/audit/audit.jsonl

# --- PII redaction (enabled by default) ---
# CAT_AGENT_PII_REDACT=0

# --- Workspace ---
# CAT_AGENT_DEFAULT_WORKSPACE=workspace

# --- Self-hosted web search (opt-in tool) ---
# CAT_AGENT_SEARXNG_URL=http://searxng.internal:8080

# --- Observability / run metrics ---
# Warn when server-reported prompt_tokens fall below this fraction of the local estimate
# (silent Ollama num_ctx truncation). Default 0.95 = 5% tokenizer tolerance.
# CAT_AGENT_PROMPT_TRUNCATION_TOLERANCE=0.95

# --- Langfuse / OpenTelemetry (examples/langfuse) ---
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-cat-agent-demo
# LANGFUSE_SECRET_KEY=sk-lf-cat-agent-demo
# OTEL_SERVICE_NAME=cat-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
